+test('publication rejects stale workspace versions without replacing the current report', async () => {
+  const projectRoot = await mkdtemp(join(tmpdir(), 'conexus-publication-stale-test-'))
+  const extraNodes = outputNodeIds.map(id => ({
+    id, type: 'note', parentId: 'harness',
+    data: { label: id, description: 'AlphaLab workspace output', content: '', data: {} },
+  }))
+  let host
+  try {
+    host = await createLocalHost({ projectRoot, slug: 'local-agent', token,
+      publicationSecret, release: release('test/local', extraNodes) })
+    const initial = await postPublication(host, publicationEnvelope())
+    assert.equal(initial.statusCode, 200, initial.body)
+
+    const stale = publicationEnvelope({ mode: 'update', workspaceRevision: 0, reportRevision: 1,
+      requestId: 'request-stale', idempotencyKey: 'delivery-stale', reportText: '# Stale overwrite',
+      intentId: 'intent-stale', requestDigest: '8'.repeat(64), payloadDigest: '7'.repeat(64) })
+    const rejected = await postPublication(host, stale)
+    assert.equal(rejected.statusCode, 409, rejected.body)
+    assert.equal(rejected.json().error.code, 'VERSION_CONFLICT')
+
+    const saved = JSON.parse(await readFile(join(projectRoot, 'state.json'), 'utf8'))
+    assert.equal(saved.revision, 1)
+    assert.equal(saved.nodes.find(node => node.id === 'report-1').values.content, '# Reviewed report')
+  } finally {
+    await host?.close()
+    await rm(projectRoot, { recursive: true, force: true })
+  }
+})
