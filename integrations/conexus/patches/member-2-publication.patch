+const publicationSecret = 'test-publication-secret-0123456789abcdef0123456789abcdef'
+const outputNodeIds = [
+  'alphalab-decision-notebook-v1',
+  'alphalab-workspace-result-v1',
+  'alphalab-workspace-commands-v1',
+]
+
+function publicationOutputs(requestId, reportId, reportText) {
+  return {
+    summary: reportText,
+    decisionNotebook: {
+      version: 1, classification: 'reviewed', baseCase: reportText,
+      riskCase: 'Synthetic test only.', nextAction: 'Inspect frozen evidence.', candidateExpressions: [],
+    },
+    workspaceResult: {
+      version: 1, requestId, kind: 'document', reportId, title: 'Reviewed report',
+      sources: [], columns: [], rows: [],
+    },
+    workspaceCommands: { version: 1, requestId, commands: [] },
+  }
+}
+
+function publicationEnvelope({ mode = 'create', workspaceRevision = 0, reportRevision = null,
+  requestId = 'request-1', idempotencyKey = 'delivery-1', reportText = '# Reviewed report',
+  intentId = 'intent-1', reportId = 'report-1', requestDigest = 'd'.repeat(64), payloadDigest = 'e'.repeat(64) } = {}) {
+  const reportSha = createHash('sha256').update(reportText, 'utf8').digest('hex')
+  const outputs = publicationOutputs(requestId, reportId, reportText)
+  const operations = [
+    { kind: 'patch', node_id: outputNodeIds[0], set: { content: reportText, data: outputs.decisionNotebook } },
+    { kind: 'patch', node_id: outputNodeIds[1], set: { content: `研究报告：${outputs.workspaceResult.title}`, data: outputs.workspaceResult } },
+    { kind: 'patch', node_id: outputNodeIds[2], set: { content: '本轮无工作台导航请求。', data: outputs.workspaceCommands } },
+  ]
+  const request = {
+    schema_version: 1, task_id: 'task-1', request_id: requestId,
+    idempotency_key: idempotencyKey, expected_task_version: 3,
+    candidate: { candidate_id: 'candidate-1', revision: 1, sha256: 'a'.repeat(64) },
+    manifest: { manifest_id: 'manifest-1', revision: 1, sha256: 'b'.repeat(64) },
+    review_submission_id: 'submission-1', correction_response_id: null,
+    draft_report: { artifact_id: 'report', sha256: reportSha, locator: '' },
+    payload_sha256: payloadDigest,
+    destination: {
+      report_id: reportId, mode,
+      expected_workspace_revision: workspaceRevision,
+      expected_report_revision: reportRevision,
+    },
+    outputs,
+  }
+  const intent = {
+    intent_id: intentId, status: 'pending', task_id: request.task_id,
+    request_id: requestId, idempotency_key: idempotencyKey,
+    request_sha256: requestDigest, request,
+  }
+  return {
+    schema_version: 1, intent, request, report_markdown: reportText,
+    report_sha256: reportSha, prepared_outputs: { status: 'succeeded', operations },
+  }
+}
+
+function signedHeaders(method, path, body = Buffer.alloc(0)) {
+  const timestamp = String(Math.floor(Date.now() / 1000))
+  const message = `${method}\n${path}\n${timestamp}\n`
+  const signature = createHmac('sha256', publicationSecret).update(message).update(body).digest('hex')
+  return {
+    'x-alphalab-publication-timestamp': timestamp,
+    'x-alphalab-publication-signature': signature,
+    ...(method === 'POST' ? { 'content-type': 'application/vnd.alphalab.publication+json' } : {}),
+  }
+}
+
+async function postPublication(host, envelope) {
+  const body = Buffer.from(JSON.stringify(envelope), 'utf8')
+  return host.app.inject({ method: 'POST', url: '/api/alphalab/publications',
+    headers: signedHeaders('POST', '/api/alphalab/publications', body), payload: body })
+}
+
+test('trusted publication atomically commits report, outputs, history and replay receipt', async () => {
+  const projectRoot = await mkdtemp(join(tmpdir(), 'conexus-publication-test-'))
+  const extraNodes = outputNodeIds.map(id => ({
+    id, type: 'note', parentId: 'harness',
+    data: { label: id, description: 'AlphaLab workspace output', content: '', data: {} },
+  }))
+  let host
+  try {
+    host = await createLocalHost({ projectRoot, slug: 'local-agent', token,
+      publicationSecret, release: release('test/local', extraNodes) })
+
+    const unauthorized = await host.app.inject({ method: 'POST', url: '/api/alphalab/publications',
+      headers: { 'content-type': 'application/vnd.alphalab.publication+json' }, payload: '{}' })
+    assert.equal(unauthorized.statusCode, 401)
+
+    const firstEnvelope = publicationEnvelope()
+    const first = await postPublication(host, firstEnvelope)
+    assert.equal(first.statusCode, 200, first.body)
+    const firstReceipt = first.json().receipt
+    assert.equal(firstReceipt.workspace_revision, 1)
+    assert.equal(firstReceipt.report_revision, 1)
+    assert.equal(first.json().replayed, false)
+
+    const workspace1 = (await host.app.inject({ url: '/api/public/harnesses/local-agent/workspace', headers })).json().workspace
+    const report1 = workspace1.nodes.find(node => node.id === 'report-1')
+    assert.equal(report1.values.content, '# Reviewed report')
+    assert.equal(report1.values.revision, 1)
+    for (const id of outputNodeIds) assert(workspace1.nodes.find(node => node.id === id)?.values?.data)
+
+    const secondEnvelope = publicationEnvelope({ mode: 'update', workspaceRevision: 1, reportRevision: 1,
+      requestId: 'request-2', idempotencyKey: 'delivery-2', reportText: '# Corrected reviewed report',
+      intentId: 'intent-2', requestDigest: 'f'.repeat(64), payloadDigest: '9'.repeat(64) })
+    const second = await postPublication(host, secondEnvelope)
+    assert.equal(second.statusCode, 200, second.body)
+    assert.equal(second.json().receipt.workspace_revision, 2)
+    assert.equal(second.json().receipt.report_revision, 2)
+
+    const saved = JSON.parse(await readFile(join(projectRoot, 'state.json'), 'utf8'))
+    assert.equal(saved.revision, 2)
+    assert.equal(saved.nodes.find(node => node.id === 'report-1').values.content, '# Corrected reviewed report')
+    assert.equal(saved.nodes.find(node => node.id === 'report-1').values.revision, 2)
+    assert.equal(saved.reportHistory.length, 1)
+    assert.equal(saved.reportHistory[0].revision, 1)
+    assert.equal(saved.reportHistory[0].content, '# Reviewed report')
+    assert.equal(saved.publicationReceipts.length, 2)
+
+    // Replaying the first committed request returns its original receipt even
+    // after a later report revision has been published.
+    const replay = await postPublication(host, firstEnvelope)
+    assert.equal(replay.statusCode, 200, replay.body)
+    assert.equal(replay.json().replayed, true)
+    assert.deepEqual(replay.json().receipt, firstReceipt)
+    const afterReplay = JSON.parse(await readFile(join(projectRoot, 'state.json'), 'utf8'))
+    assert.equal(afterReplay.revision, 2)
+
+    const receiptPath = '/api/alphalab/publications/delivery-2'
+    const receiptLookup = await host.app.inject({ method: 'GET', url: receiptPath,
+      headers: signedHeaders('GET', receiptPath) })
+    assert.equal(receiptLookup.statusCode, 200, receiptLookup.body)
+    assert.equal(receiptLookup.json().receipt.report_revision, 2)
+  } finally {
+    await host?.close()
+    await rm(projectRoot, { recursive: true, force: true })
+  }
+})
