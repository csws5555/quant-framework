+test('publication receipt and report history survive a Local Host restart', async () => {
+  const projectRoot = await mkdtemp(join(tmpdir(), 'conexus-publication-restart-'))
+  const extraNodes = outputNodeIds.map(id => ({
+    id, type: 'note', parentId: 'harness',
+    data: { label: id, description: 'AlphaLab workspace output', content: '', data: {} },
+  }))
+  const candidateRelease = release('test/local', extraNodes)
+  let host
+  try {
+    host = await createLocalHost({ projectRoot, slug: 'local-agent', token,
+      publicationSecret, release: candidateRelease })
+    const firstEnvelope = publicationEnvelope()
+    const first = await postPublication(host, firstEnvelope)
+    assert.equal(first.statusCode, 200, first.body)
+    const firstReceipt = first.json().receipt
+    const secondEnvelope = publicationEnvelope({ mode: 'update', workspaceRevision: 1, reportRevision: 1,
+      requestId: 'request-restart-2', idempotencyKey: 'delivery-restart-2',
+      reportText: '# Reviewed revision two', intentId: 'intent-restart-2',
+      requestDigest: '6'.repeat(64), payloadDigest: '5'.repeat(64) })
+    const second = await postPublication(host, secondEnvelope)
+    assert.equal(second.statusCode, 200, second.body)
+    await host.close()
+    host = undefined
+
+    host = await createLocalHost({ projectRoot, slug: 'local-agent', token,
+      publicationSecret, release: candidateRelease })
+    const workspace = (await host.app.inject({
+      url: '/api/public/harnesses/local-agent/workspace', headers,
+    })).json().workspace
+    assert.equal(workspace.revision, 2)
+    assert.equal(workspace.nodes.find(node => node.id === 'report-1').values.content,
+      '# Reviewed revision two')
+
+    const path = '/api/alphalab/publications/delivery-1'
+    const recovered = await host.app.inject({ method: 'GET', url: path,
+      headers: signedHeaders('GET', path) })
+    assert.equal(recovered.statusCode, 200, recovered.body)
+    assert.deepEqual(recovered.json().receipt, firstReceipt)
+    const replay = await postPublication(host, firstEnvelope)
+    assert.equal(replay.statusCode, 200, replay.body)
+    assert.equal(replay.json().replayed, true)
+    const saved = JSON.parse(await readFile(join(projectRoot, 'state.json'), 'utf8'))
+    assert.equal(saved.revision, 2)
+    assert.equal(saved.reportHistory.length, 1)
+    assert.equal(saved.reportHistory[0].content, '# Reviewed report')
+    assert.equal(saved.publicationReceipts.length, 2)
+  } finally {
+    await host?.close()
+    await rm(projectRoot, { recursive: true, force: true })
+  }
+})
